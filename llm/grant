# the second node — a local model served by llama.cpp; its whole grant is the model, its state, its port
# (board/work-environment-ai.md, 2026-08-26: measured before this file existed).  The model is data the
# person brings into llm/model/ (gitignored); $MODEL is the first *.gguf there.
allow model
# the SYCL build's runtime on the work laptop (2026-08-28) — readable where it is, no refusal where it is not
allow-try /opt/intel/oneapi
# the GPU, proposed 2026-08-28 from inside a fence that has neither: the run under keep died with "can not
# find preferred GPU platform" — Level Zero enumerates through /sys (not in keep's SYSTEM_READ) and opens
# /dev/dri/renderD* read-write (the write boundary is on).  Measured by the next run here, not before
allow /sys
write /dev/dri
bind 18080
idle 60
sitting 10
pulse server.log
program llama-server -m $MODEL --host 127.0.0.1 --port 18080 -c 2048 -t 2 --log-file $STATE/server.log

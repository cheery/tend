# the second node — a local model served by llama.cpp; its whole grant is the model, its state, its port
# (board/work-environment-ai.md, 2026-08-26: measured before this file existed).  The model is data the
# person brings into llm/model/ (gitignored); $MODEL is the first *.gguf there.
allow model
# the mind, named (2026-08-30, Henri: "I'd want the bigger mind"): until this line $MODEL was the first *.gguf by
# name, which was MiniCPM5-1B — a morning's talk answered by a 1B model that sorted before gemma.  Named here, the
# pick is written, and `launch.sh llm check` is red when the file is not
model model/gemma-4-26B-A4B-it-UD-Q4_K_XL.gguf
# the SYCL build's runtime on the work laptop (2026-08-28) — readable where it is, no refusal where it is not
allow-try /opt/intel/oneapi
# the GPU, proposed 2026-08-28 from inside a fence that has neither: the run under keep died with "can not
# find preferred GPU platform" — Level Zero enumerates through /sys (not in keep's SYSTEM_READ) and opens
# /dev/dri/renderD* read-write (the write boundary is on).  Measured by the next run here, not before
allow /sys
write /dev/dri
# the SYCL runtime's kernel cache: 80 s and 81 s on consecutive starts under keep (2026-08-28), because its
# default cache is under ~/.cache, which keep does not grant.  Tried 08:17 as
#     env SYCL_CACHE_PERSISTENT=1
#     env SYCL_CACHE_DIR=$STATE/sycl-cache
# and both starts died 139 at the kernel build with no cache written; without the two lines the node loads.
# Taken out until the same env outside keep says whether it is the runtime or the boundary (done/node-install.md)
# The GPU driver's own cache instead: by hand, 82 s to 11 s on the second start (2026-08-28, 08:50), and the
# driver does not create its directory — absent, it caches nothing and says nothing
make neo-cache
env NEO_CACHE_PERSISTENT=1
env NEO_CACHE_DIR=$STATE/neo-cache
bind 18080
idle 60
sitting 10
pulse server.log
program llama-server -m $MODEL --host 127.0.0.1 --port 18080 -c 8192 -t 2 --log-file $STATE/server.log

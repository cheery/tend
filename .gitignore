*.patch

# the hook installers keep the previous settings beside the file; the person's, never tree content
.claude/settings.json.before-*

# the second node's model — data, hundreds of MB, downloaded by the person; never tree content
llm/model/

# the second node's state — runtime, like node/state/
llm/state/

# the second node's own llama.cpp build on a machine that has one (the work laptop, 2026-08-28: SYCL) — the person brings it, like the model
llm/bin/

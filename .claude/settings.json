{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git remote:*)",
      "Bash(git config:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api --method DELETE:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(python -m pip install:*)",
      "Bash(python3 -m pip install:*)",
      "Bash(uv pip install:*)",
      "Bash(cargo install:*)",
      "Bash(cargo publish:*)",
      "Bash(cargo update:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npx:*)",
      "Bash(yarn add:*)",
      "Bash(apt install:*)",
      "Bash(apt-get install:*)",
      "Bash(snap install:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(socat:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chmod 777:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(ssh-keygen:*)",
      "Bash(ssh-add:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/sessions/**)",
      "Read(~/.claude/history.jsonl)",
      "Read(~/.claude/session-env/**)",
      "Read(~/.claude/shell-snapshots/**)",
      "Read(~/.netrc)",
      "Edit(~/.ssh/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/plugins/**)",
      "Edit(./.claude/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.profile)",
      "Edit(~/.config/**)",
      "Edit(./tools/sandbox.sh)",
      "Edit(./tools/fence-hook.sh)",
      "Edit(./tools/fence.sh)",
      "Edit(./tools/limit.sh)",
      "Edit(./tools/kaizen.sh)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/kaizen.sh --hook"
          },
          {
            "type": "command",
            "command": "/home/cheery/tend/tools/limit.sh --hook"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/fence.sh --hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "TEND_REACH_ALLOW=bus,net,audio,display \"$CLAUDE_PROJECT_DIR\"/tools/fence-hook.sh"
          }
        ]
      }
    ]
  }
}
